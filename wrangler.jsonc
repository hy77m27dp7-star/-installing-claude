{
  // Avelie runtime. Private, single owner. Every route runs through the Worker first
  // (run_worker_first) so static assets and images are never served without auth.
  "name": "avelie",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev address stays off. She lives at avelie.bladepharoh.com (Justin, 2026-09-24),
  // attached as a Worker custom domain; Cloudflare Access fronts that hostname (DEPLOY.md).
  "workers_dev": false,
  // No preview URLs either: she is reachable through the custom domain and nothing else.
  "preview_urls": false,
  "routes": [
    { "pattern": "avelie.bladepharoh.com", "custom_domain": true }
  ],
  // Local dev only (ignored by deploy). With a route configured, wrangler dev rewrites the
  // origin every local request carries (request.url and Host) to the route's hostname, which
  // would defeat the local actor rule in src/auth.ts (host must be localhost or 127.0.0.1)
  // and answer 503 to every local request. This keeps the local origin.
  "dev": {
    "host": "127.0.0.1"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avelie",
      // Created 2026-09-24 through the Cloudflare connector (ENAM).
      "database_id": "2c14ef65-a599-414d-b0d1-3f71b27c377a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "avelie-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Cloudflare Access team domain for this account (from HQ MAP.md).
    "ACCESS_TEAM_DOMAIN": "still-leaf-20a0.cloudflareaccess.com",
    // AUD tag of the Access application that fronts this Worker. Empty = fail closed.
    "ACCESS_AUD": "8c6fcde61406628c044accbd8b0222613cafe4cca237aebfd9c82646212b2ff7",
    "OWNER_EMAIL": "justin@newsomeprojects.com",
    "APP_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
